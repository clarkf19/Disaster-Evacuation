# Mumbai Disaster Evacuation System — Environment Variables
#
# Copy this file to .env and fill in the values.
# The .env file is gitignored — NEVER commit actual keys.
#
# The TomTom API key is used ONLY by the Spring Boot backend.
# It is configured in backend/src/main/resources/application.yml.
# The frontend (React & HTML/JS) never sees or handles this key.
#
# Get a free TomTom key at: https://developer.tomtom.com
# Free tier: 2,500 calls/day, no credit card required.

TOMTOM_API_KEY=your_tomtom_api_key_here

# Emergency AI Assistant configuration (Gemini / OpenAI / Groq)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
