# Mumbai Disaster Evacuation System — Environment Variables
#
# Copy this file to .env (repo root) and fill in the values. The backend reads
# it automatically when started from backend/ (see application.yml), and real
# environment variables always take precedence. .env is gitignored — NEVER
# commit real keys.
#
# Every key is optional: without TomTom the route planner uses the
# hazard-aware road graph only; without Gemini the chatbot uses its offline
# fallback answers.

# Live traffic (https://developer.tomtom.com — free tier 2,500 calls/day)
TOMTOM_API_KEY=

# Emergency AI assistant (Google AI Studio key). Override the model if it is retired.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Operator token required to add/remove disasters and change shelter capacity.
# REQUIRED in any deployed environment; leave empty only for local development.
ADMIN_TOKEN=

# Only needed if a browser calls the backend directly (not via the Vite/Vercel /api proxy)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Evacuation traffic model
EVAC_PERSONS_PER_VEHICLE=4
EVAC_WINDOW_HOURS=3
