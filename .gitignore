# ============================================================
# Mumbai Disaster Evacuation System — .gitignore
# Stack: Java/Spring Boot · Python/OSMnx · React/Vite · Node
# ============================================================


# ── Environment & Secrets ───────────────────────────────────
# NEVER commit API keys or environment configs containing secret keys
.env
.env.*
!.env.example
*.local
application-secret.yml
application-local.yml
secrets/


# ── Required Data Files (Un-ignore Essential CSV Datasets) ───
data/*.csv
!data/mumbai_nodes.csv
!data/mumbai_edges.csv
!backend/data/mumbai_nodes.csv
!backend/data/mumbai_edges.csv
data/*.json
data/*.pkl
data/*.parquet
data/raw/
data/processed/
cache/
data/cache/
graph_cache/
*.graphml
*.pickle
osmnx_cache/


# ── Java / Spring Boot / Maven ──────────────────────────────
target/
backend/target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/
*.class
*.jar
*.war
*.ear
*.nar
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.properties


# ── Python / OSMnx / Data Processing ───────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
venv/
.venv/
env/
ENV/
pip-log.txt
pip-delete-this-directory.txt
.tox/
.eggs/
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.hypothesis/

# Jupyter / IPython
.ipynb_checkpoints/
*.ipynb_checkpoints
profile_default/
ipython_config.py


# ── Node.js / React / Vite (Single Frontend under /frontend) ─
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Vite build output
frontend/dist/
frontend/dist-ssr/
frontend/.vite/

# Storybook / testing
storybook-static/
coverage/
.nyc_output/


# ── IDE & Editor ────────────────────────────────────────────
# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/
.idea_modules/

# VS Code
.vscode/
!.vscode/extensions.json

# Eclipse
.settings/
.project
.classpath
.factorypath

# NetBeans
nbproject/private/
nb-configuration.xml
nbbuild/
nbdist/

# Vim/Emacs
*.swp
*.swo
*~
\#*\#
.\#*


# ── OS Metadata & Temporary Scripts ─────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
test_*.ps1
test_*.sh


# ── Logs & Temporary Files ──────────────────────────────────
*.log
logs/
tmp/
temp/
*.tmp
*.temp
*.bak
*.orig
*.rej


# ── Database ────────────────────────────────────────────────
*.sql.bak
*.dump
*.pgdump
pgdata/
postgres-data/
